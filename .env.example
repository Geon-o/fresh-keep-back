# 복사해서 `.env` 를 만든 뒤 값을 채우세요. (.env 는 커밋 금지 — .gitignore 처리됨)
# application.yaml 이 `${VAR}` 로 읽습니다. `${VAR:기본값}` 은 미설정 시 기본값 사용.

# MySQL Database Configuration
DB_URL=jdbc:mysql://<DB_HOST>:<DB_PORT>/<DB_NAME>?createDatabaseIfNotExist=true&useUnicode=true&characterEncoding=utf-8&serverTimezone=Asia/Seoul
DB_USERNAME=<DB 계정>
DB_PASSWORD=<DB 비밀번호>

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# JWT Configurations (Base64 Encoded Key - 256 bits minimum)
# NOTE: 운영 환경에서는 이 값을 재사용하지 말고 별도의 고엔트로피 키를 환경변수로 주입할 것. (예: openssl rand -base64 48)
JWT_SECRET=<Base64 랜덤 키>

# HMAC secret for hashing link codes / device UUIDs (server-side pepper)
# NOTE: 운영에서는 별도의 고엔트로피 키를 환경변수로 주입. 이 키가 바뀌면 기존 해시 조회가 불가하니 로테이션 주의.
HMAC_SECRET=<고엔트로피 랜덤 문자열>

# 소셜 로그인
# GOOGLE_WEB_CLIENT_ID: 앱이 idToken 받을 때 쓴 "웹 애플리케이션" 클라이언트 ID. 서버가 idToken 의 aud 검증에 사용(위조 방지).
#   프론트 EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID 와 동일 값. 미설정 시 aud 검증 생략 → 운영은 반드시 설정.
# NAVER_CLIENT_ID / NAVER_CLIENT_SECRET: 현재 서버는 네이버 accessToken 으로 /v1/nid/me 만 호출하므로
#   반드시 필요하진 않음(향후 서버측 검증 강화 시 사용). 실제 .env 와 동일하게 항목만 남겨둠.
NAVER_CLIENT_ID=<네이버 Client ID>
NAVER_CLIENT_SECRET=<네이버 Client Secret>
GOOGLE_WEB_CLIENT_ID=<xxxxx.apps.googleusercontent.com>
# GOOGLE_WEB_CLIENT_SECRET — idToken 서명검증만 하면 불필요. 쓸 거면 여기만.

# (선택) CORS 허용 오리진. 미설정 시 application.yaml 기본값(localhost). 운영은 실제 도메인만.
# CORS_ALLOWED_ORIGINS=https://app.example.com
# (선택) 서버 포트. 미설정 시 8086.
# SERVER_PORT=8086
